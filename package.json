{
  "name": "butte-bible-fellowship",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "generate": "turbo run generate --filter=@bbf/web",
    "preview": "turbo run preview",
    "lint": "oxlint && pnpm -r lint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "pnpm --filter @bbf/web test:watch",
    "test:coverage": "turbo run test:coverage"
  },
  "devDependencies": {
    "@bbf/toolbox": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:"
  },
  "packageManager": "pnpm@10.27.0"
}
