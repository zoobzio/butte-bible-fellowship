{
  "name": "@bbf/utils",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./dto": "./src/dto/index.ts",
    "./dao": "./src/dao/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
