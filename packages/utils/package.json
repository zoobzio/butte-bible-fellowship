  },
  "devDependencies": {
    "@bbf/toolbox": "workspace:*",
    "@bezoar/testing": "catalog:",
    "@types/hast": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
