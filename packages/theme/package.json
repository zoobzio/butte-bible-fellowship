{
  "name": "@bbf/theme",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./.output/index.d.mts",
      "default": "./.output/index.mjs"
    },
    "./config": {
      "types": "./.output/config.d.mts",
      "default": "./.output/config.mjs"
    },
    "./manifest": {
      "types": "./.output/manifest.d.mts",
      "default": "./.output/manifest.mjs"
    },
    "./layers": {
      "types": "./.output/layers.d.mts",
      "default": "./.output/layers.mjs"
    },
    "./layers/*": "./.output/layers/*",
    "./preset.json": "./.output/preset.json",
    "./resolver.json": "./.output/resolver.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "untheme build",
    "prepare": "untheme build",
    "generate": "node scripts/generate.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "untheme": "catalog:"
  },
  "devDependencies": {
    "@untheme/aurora": "catalog:",
    "@untheme/kit": "catalog:",
    "vitest": "catalog:"
  }
}
