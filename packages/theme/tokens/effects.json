{
  "elevation": {
    "$type": "shadow",
    "low": {
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0.16, 0.11, 0.06], "alpha": 0.16 },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 1, "unit": "px" },
        "blur": { "value": 2, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "mid": {
      "$value": [
        {
          "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.15 },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 2, "unit": "px" },
          "blur": { "value": 4, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        },
        {
          "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.1 },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 4, "unit": "px" },
          "blur": { "value": 8, "unit": "px" },
          "spread": { "value": -2, "unit": "px" }
        }
      ]
    }
  },
  "blur": {
    "$type": "dimension",
    "sm": { "$value": { "value": 12, "unit": "px" } }
  },
  "stroke": {
    "$type": "strokeStyle",
    "solid": { "$value": "solid" }
  },
  "border": {
    "$type": "border",
    "focus": {
      "$value": {
        "color": "{color.primary.$root}",
        "width": { "value": 2, "unit": "px" },
        "style": "{stroke.solid}"
      }
    }
  },
  "gradient": {
    "$type": "gradient",
    "brand": {
      "$description": "Stops only; CSS output is a stop list to wrap at the usage site, e.g. linear-gradient(108deg, var(--gradient-brand)).",
      "$value": [
        { "color": "{palette.primary.500}", "position": 0 },
        { "color": "{palette.secondary.400}", "position": 0.52 },
        { "color": "{palette.tertiary.500}", "position": 1 }
      ]
    }
  }
}
