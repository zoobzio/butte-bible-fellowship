{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Work Sans", "system-ui", "sans-serif"] },
      "display": { "$value": ["Newsreader", "Georgia", "serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 }
    },
    "size": {
      "$type": "dimension",
      "display": { "$value": { "value": 3.25, "unit": "rem" } },
      "headline": { "$value": { "value": 2, "unit": "rem" } },
      "title": { "$value": { "value": 1.25, "unit": "rem" } },
      "body": { "$value": { "value": 1, "unit": "rem" } },
      "label": { "$value": { "value": 0.875, "unit": "rem" } }
    },
    "line-height": {
      "$type": "number",
      "display": { "$value": 1.15 },
      "headline": { "$value": 1.25 },
      "title": { "$value": 1.4 },
      "body": { "$value": 1.5 },
      "label": { "$value": 1.35 }
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.display}",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": { "value": -0.25, "unit": "px" },
        "lineHeight": "{font.line-height.display}"
      }
    },
    "headline": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.headline}",
        "fontWeight": "{font.weight.medium}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": "{font.line-height.headline}"
      }
    },
    "title": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.title}",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": "{font.line-height.title}"
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.body}",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": "{font.line-height.body}"
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.label}",
        "fontWeight": "{font.weight.medium}",
        "letterSpacing": { "value": 0.5, "unit": "px" },
        "lineHeight": "{font.line-height.label}"
      }
    }
  }
}
