{
  "duration": {
    "$type": "duration",
    "fast": { "$value": { "value": 150, "unit": "ms" } },
    "base": { "$value": { "value": 250, "unit": "ms" } },
    "slow": { "$value": { "value": 400, "unit": "ms" } }
  },
  "delay": {
    "$type": "duration",
    "step": {
      "$description": "Stagger between items entering in sequence.",
      "$value": { "value": 60, "unit": "ms" }
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1] },
    "enter": { "$value": [0.05, 0.7, 0.1, 1] }
  },
  "transition": {
    "$type": "transition",
    "fast": {
      "$value": {
        "duration": "{duration.fast}",
        "delay": { "value": 0, "unit": "ms" },
        "timingFunction": "{easing.standard}"
      }
    },
    "base": {
      "$value": {
        "duration": "{duration.base}",
        "delay": { "value": 0, "unit": "ms" },
        "timingFunction": "{easing.standard}"
      }
    }
  }
}
