{
  "name": "@bbf/prose",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./.output/index.d.mts",
      "import": "./.output/index.mjs"
    },
    "./bundles": {
      "types": "./.output/bundles.d.mts",
      "import": "./.output/bundles.mjs"
    }
  },
  "scripts": {
    "build": "prosary build",
    "prepare": "prosary build",
    "translate": "node --env-file-if-exists=.env node_modules/@prosary/kit/bin/prosary.mjs translate",
    "translate:check": "prosary translate --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@prosary/kit": "catalog:",
    "@prosary/parse": "catalog:",
    "prosary": "catalog:",
    "rehype-slug": "catalog:"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@prosary/translate": "catalog:",
    "vitest": "catalog:"
  }
}
