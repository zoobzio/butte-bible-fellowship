# The database: a Postgres connection string, for the pg driver — the same
# database the site reads, as the admin's own login user, a member of the
# `admin` role. Set it in Vercel; `pnpm dev` runs a Postgres in the process
# instead and needs none. `make up` points the app at the Postgres of
# `compose.yaml` instead.
NUXT_BEZOAR_URL=

# Google sign-in: a Google Cloud OAuth client of type Web application, with
# `<origin>/api/auth/callback` among its authorised redirect URIs —
# `http://localhost:3001/api/auth/callback` for `pnpm dev`.
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
# What the session cookie is sealed under: at least 32 characters, e.g.
# `openssl rand -base64 32`. Rotating it signs everyone out.
NUXT_SESSION_SECRET=
