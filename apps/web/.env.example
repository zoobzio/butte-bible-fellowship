# Nuxt Studio (/_studio) — editors sign in with Google, publishing commits
# through a GitHub token. Set these in Vercel; none are needed for `pnpm dev`.
STUDIO_GOOGLE_CLIENT_ID=
STUDIO_GOOGLE_CLIENT_SECRET=
# Comma-separated Google account emails allowed to edit (required).
STUDIO_GOOGLE_MODERATORS=
# Fine-grained GitHub token with Contents read/write on this repository.
STUDIO_GITHUB_TOKEN=

# The database: a Postgres connection string, for the pg driver, as the
# site's own login user, a member of the `web` role. Set it in Vercel;
# `pnpm dev` runs a Postgres in the process instead and needs none.
NUXT_BEZOAR_URL=
